# Copy to /etc/blur-net-mvp.env (systemd) or decode/../.env (Compose).
# No secret belongs in this file. The resume tokens are created at runtime and
# stored only in the state file, which is written with mode 0600.
#
# Bind to loopback when Caddy/nginx/cloudflared is in front. The public listener
# is the reverse proxy on 443 (or the tunnel), never plain ws://.
NET_MVP_HOST=127.0.0.1
NET_MVP_PORT=8810

# Capacity: default seats when a host omits maxPlayers, and the hard maximum.
# Requests outside 2..20 are rejected with NET_CAPACITY, never clamped.
NET_MVP_DEFAULT_MAX_PLAYERS=8
NET_MVP_HARD_MAX_PLAYERS=20

# Room/connection bounds and safety.
NET_MVP_MAX_ROOMS=64
NET_MVP_MAX_CONNECTIONS=512
NET_MVP_MAX_CONNECTIONS_PER_IP=16
NET_MVP_MAX_MESSAGE_BYTES=65536
NET_MVP_RATE_LIMIT_PER_SECOND=12000
NET_MVP_JOIN_BURST=30
NET_MVP_JOIN_RATE_PER_SECOND=1
NET_MVP_CREATE_BURST=10
NET_MVP_CREATE_RATE_PER_SECOND=0.2

# Liveness / resume / reaping.
NET_MVP_HEARTBEAT_MS=1000
NET_MVP_HEARTBEAT_TIMEOUT_MS=4500
NET_MVP_RESUME_WINDOW_MS=30000
NET_MVP_IDLE_ROOM_MS=300000
NET_MVP_ROOM_TTL_MS=7200000
NET_MVP_EMPTY_ROOM_MS=60000

# Trust CF-Connecting-IP / X-Forwarded-For only when a trusted proxy is the
# only way to reach this listener. Keep 0 if clients connect directly.
NET_MVP_TRUST_PROXY=1

# Optional graceful-restart persistence. The directory must be writable by the
# service user. Compose uses the named volume at /data.
NET_MVP_STATE_FILE=/var/lib/blur-net-mvp/rooms.json

# Native TLS (only if not terminating at Caddy/nginx/cloudflared). Both files
# are required together; a missing one is a fatal startup error, not a silent
# fallback to ws://.
# NET_MVP_TLS_CERT=/etc/blur-net-mvp/fullchain.pem
# NET_MVP_TLS_KEY=/etc/blur-net-mvp/privkey.pem
# NET_MVP_PORT=8443

# Log level: info (JSON events) or quiet.
NET_MVP_LOG_LEVEL=info
