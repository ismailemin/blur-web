+#ifndef __SYSTEM_SERIALISE_PLATFORM_FILE_WEB_H__
+#define __SYSTEM_SERIALISE_PLATFORM_FILE_WEB_H__
+
+// platform/file - the only storage boundary a wasm32 build may cross.
+//
+// This header is pure C: no engine type, no C++ and no platform header is
+// needed to implement it. The implementation is an imported JS function set
+// (`engine-file-spike/harness/web_file_source.js` in the spike; a browser
+// provider set in production). See docs/work/analysis/t005-streaming-design.md
+// section 4.2 for the contract this is derived from, and
+// docs/work/analysis/engine-file-layer.md for the differences.
+//
+// Contract, and it is deliberately narrow:
+//
+//   * A source is an opaque, already-installed byte range: a user-selected
+//     File/Blob, an OPFS file handle, or an HTTP range endpoint. JS owns the
+//     registry; C++ owns which engine path maps to which source
+//     (C_WebFileSystem::Mount). JS never sees an engine virtual path.
+//   * pf_read_at answers with the COMPLETE requested range or with 0. A short
+//     or missing range is a hard failure, never a zero fill: the missing bytes
+//     are unknown, and this project does not invent bytes.
+//   * Every range is validated on both sides (offset/length are safe integers,
+//     length >= 1, offset <= size - length computed without overflow, size
+//     unchanged since install). A rejected range prints its offset, length and
+//     the source size on stderr and returns 0.
+//   * pf_open only succeeds for PF_ACCESS_READ. The write path (saves) is a
+//     separate slice; pf_write_at refuses instead of pretending.
+//   * pf_enqueue_read is declared because the streamer needs a pointer-targeted
+//     asynchronous read (design section 5.3), and refuses because this build has
+//     no completion pump. It is not a synchronous fallback.
+//
+// Handle 0 is invalid. Handles are small integers; they are not pointers and
+// must not escape the engine file layer.
+
+#if defined(PLATFORM_WEB)
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PF_ABI_VERSION 1u
+
+#define PF_ACCESS_READ  0x00000001u
+#define PF_ACCESS_WRITE 0x00000002u
+#define PF_ACCESS_APPEND 0x00000003u
+
+// Returns the JS provider's ABI version; must equal PF_ABI_VERSION. Checked by
+// the backend before any other call so a mismatched provider fails at once.
+uint32_t pf_abi_version(void);
+
+// Installs nothing: the source must already be registered under `sourceId` by
+// the host. Returns a non-zero handle, or 0 (with a stderr reason) on failure.
+uint32_t pf_open(const char* sourceId, uint32_t access);
+
+// Size in bytes of the opened source, or 0 for an invalid handle. The size is
+// captured at open time; the provider must not serve a source that changed.
+uint64_t pf_size(uint32_t handle);
+
+// Copies `bytes` bytes at `offset` of the opened source into the wasm linear
+// address `dst`. Returns `bytes` on success, 0 on any failure. Partial results
+// are impossible by contract: a provider that cannot answer the whole range
+// must fail, not truncate.
+uint32_t pf_read_at(uint32_t handle, uint64_t offset, void* dst, uint32_t bytes);
+
+// Write path: not implemented in this slice. Returns 0 and reports on stderr.
+uint32_t pf_write_at(uint32_t handle, uint64_t offset, const void* src, uint32_t bytes);
+
+void pf_close(uint32_t handle);
+
+// 1 if the source id is registered, 0 otherwise. An unregistered id is a
+// legitimate "does not exist" answer, not an error.
+uint32_t pf_exists(const char* sourceId);
+
+// Asynchronous pointer-targeted read for the streamer. dstAddr is a wasm linear
+// address. No completion pump exists in this build, so this returns -1 and
+// reports on stderr; it must never be used as a synchronous read.
+int32_t pf_enqueue_read(uint32_t handle, uint64_t offset, uint32_t bytes, uint32_t dstAddr);
+
+#ifdef __cplusplus
+} // extern "C"
+#endif
+
+#endif // PLATFORM_WEB
+
+#endif // __SYSTEM_SERIALISE_PLATFORM_FILE_WEB_H__
