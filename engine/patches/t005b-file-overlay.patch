+#ifndef __SYSTEM_SERIALISE_C_WEBFILE_H__
+#define __SYSTEM_SERIALISE_C_WEBFILE_H__
+
+#if defined(PLATFORM_WEB)
+
+#pragma once
+
+#include <system/serialise/I_File.h>
+#include <system/serialise/I_FileSystem.h>
+
+// A file and a file system over the platform/file C ABI (PlatformFileWeb.h).
+//
+// This is the wasm32 sibling of C_File/C_FileSystem, not a wrapper around them:
+// C_File's non-Windows branch cannot be used (its direct-read gate compares a
+// byte count with sizeof(U8*), its fread branch compares an element count with a
+// byte count, and it seeks with fseek), and C_FileSystem::Open returns an
+// AsyncFile, which needs a second thread. Both are bypassed on web (design
+// section 1.1 and 1.2); the engine-facing contract is unchanged.
+//
+// What is faithful to C_File:
+//   * the I_BinaryStream contract: Underflow fills a buffer, or reads straight
+//     into the caller's target when the request is at least one buffer long;
+//   * GetPosition/SetPosition track the logical position, and a seek inside the
+//     resident buffer does not touch storage;
+//   * Length() is the source size captured at open;
+//   * a read at end of file returns false, exactly as C_File::Underflow does
+//     after DoFileRead reports 0 bytes.
+//
+// What is deliberately different, and why:
+//   * the direct-read gate is `ctx.readSize >= m_bufferBytes`, the allocated
+//     buffer size, never sizeof(pointer) (C_File.cpp:402). On wasm32 the old
+//     gate would send every read of 4 bytes or more down the direct path;
+//   * a failure to deliver a whole range is reported through Sys::FileRwError
+//     and fails the read; it is never zero filled;
+//   * a range handed to the platform is always inside the source
+//     (offset + bytes <= size). The clamp only shortens the last request, so the
+//     ABI's "complete range or 0" contract holds for every call;
+//   * writes are refused. The save slice owns them (design section 6).
+
+namespace Sys
+{
+
+class C_WebFileSystem;
+
+class C_WebFile : public I_File
+{
+public:
+	friend class C_WebFileSystem;
+
+	virtual const C_StreamSize		Length();
+
+	virtual const C_StreamPos		GetPosition() const;
+
+	virtual void					SetPosition( const C_StreamPos newPosition );
+
+	virtual const bool				IsWriting() const;
+
+	virtual Btl::String				Name() const;
+
+	virtual bool					Underflow( UnderflowContext& ctx );
+
+	virtual bool					Overflow();
+
+	virtual const bool				GetEndianSwapFlag() const;
+	virtual void					SetEndianSwapFlag( const bool swizzle );
+
+	virtual U32						GetVersionNumber() const;
+	virtual void					SetVersionNumber( U32 iVersion );
+
+	virtual void					Flush();
+
+	virtual							~C_WebFile();
+
+protected:
+									C_WebFile();
+
+	// sourceId is a platform/file source id, already registered by the host.
+	bool							Open(
+		const char* sourceId,
+		const U32 fileAccessAttributes,
+		bool isCritical,
+		U32 bufferBytes );
+
+	void							Close();
+
+	const bool						IsOpen() const;
+
+private:
+	// Drops the resident buffer; the next read refills it.
+	void							DiscardBuffer();
+
+	// One range request. `bytes` is always > 0 and always inside the source.
+	bool							ReadRange( U64 offset, U8* destination, U32 bytes );
+
+	// Resident read buffer. Allocated in Open, freed in Close.
+	U8*							m_pBuffer;
+	U32							m_bufferBytes;
+	U64							m_bufferStart;
+	U64							m_bufferValid;
+
+	U32							m_handle;
+	U64							m_size;
+
+	// C_File's position model (C_File.cpp:91-102, 245-251): the logical
+	// position is derived from the cursor, because I_BinaryStream::Read advances
+	// m_pCurBuffer directly and no layer tells the file about it. A cached
+	// position counter would go stale after any read served from the buffer.
+	// m_iBufferOffset is the end offset of the resident buffer, or the seek
+	// position when no buffer is resident (the same meaning as C_File's field).
+	U64							m_iBufferOffset;
+
+	Btl::String					m_Name;
+
+	bool						m_bWriting;
+	bool						m_bEndianSwapFlag;
+	bool						m_bIsOpen;
+	bool						m_IsCritical;
+	U32							m_iVersion;
+};
+
+// The default file system for a wasm32 build. Install it with
+// Sys::SetDefaultFileSystem() - the engine's single injection point
+// (FileSystemGlobals.h:28-32); nothing else selects it.
+//
+// Mount() is the path -> source table the design keeps in C++ (section 4.2):
+// the engine's virtual paths arrive lowercased and separated by the local token
+// (FilePath.inl:1-8), and each mount prefix is resolved to one platform source.
+class C_WebFileSystem : public I_FileSystem
+{
+public:
+	static const U32 kMaxMounts = 8;
+	static const U32 kMaxSourceId = 96;
+	static const U32 kDefaultBufferBytes = 16 * 1024;	// C_File.h:13
+	static const U32 kMaxBufferBytes = 1024 * 1024;
+
+	struct Counters
+	{
+		U64 openAttempts;
+		U64 openSucceeded;
+		U64 writeOpenRefused;
+		U64 unmountedOpenRefused;
+		U64 bufferHintRefused;
+		U64 reads;
+		U64 readBytes;
+		U64 readFailures;
+		U64 closes;
+		U64 exists;
+		U64 fileInfo;
+		U64 unsupportedCalls;
+		U64 abiMismatch;
+	};
+
+	static const Counters&			GetCounters();
+	static void						ResetCounters();
+
+	virtual							~C_WebFileSystem();
+
+	// Registers `prefix` -> `sourceId`. Returns false when the table is full,
+	// the source id is too long, or the prefix is empty; the caller must treat
+	// that as a configuration error, never as a silent no-mount.
+	bool							Mount( const C_FilePath& prefix, const char* sourceId );
+
+	virtual I_File*					Open(
+		const C_FilePath& fileName,
+		const E_FileAccess fileAccess = E_FileAccess_Read,
+		const C_OpenParams& params = C_OpenParams() );
+
+	virtual bool					FileExists( const C_FilePath& fileName );
+
+	virtual bool					FileInfo( const C_FilePath& fileName, C_FileInfo* pFileInfo );
+
+	// A byte source has no directory listing. Returns false and counts the call;
+	// the base class contract already documents false as "an error occurred".
+	virtual bool					DirectoryInfo( const C_FilePath& filePath, C_DirectoryInfo* pDirectoryInfo );
+
+	// There is no operating-system path in a wasm32 build; the virtual path is
+	// returned unchanged so a caller cannot fabricate a host path from it.
+	virtual C_FilePath				GetSystemFilePath( const C_FilePath& filePath ) const;
+
+private:
+	struct MountPoint
+	{
+		C_FilePath					Prefix;
+		char						SourceId[ kMaxSourceId ];
+	};
+
+	const char*						FindSource( const C_FilePath& fileName ) const;
+
+	MountPoint						m_Mounts[ kMaxMounts ];
+	U32								m_MountCount;
+};
+
+} // namespace Sys
+
+#endif // PLATFORM_WEB
+
+#endif // __SYSTEM_SERIALISE_C_WEBFILE_H__
