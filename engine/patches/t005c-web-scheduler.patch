+/* jobqueue_web.h - TL_PLAT_WEB type layer for system/scheduler/jobqueue.h.
+ *
+ * SPIKE ARTIFACT, not engine code. Types only: no lifecycle, no queue, no
+ * policy. It is the sibling of jobqueue_xenon.h / jobqueue_ps3.h and exists so
+ * that the shared jobqueue.cpp / jobqueue_kernel.cpp see the same struct layout
+ * they see on PC.
+ *
+ * Differences from jobqueue_xenon.h are deliberate and minimal:
+ *   - no <windows.h>
+ *   - _jqWorker::Thread is tlThreadHandle instead of HANDLE. On PC
+ *     tlThreadHandle is U64 and HANDLE is a pointer, so both are pointer-width;
+ *     under PLATFORM_WEB no thread object exists at all and tlCreateThread
+ *     returns 0.
+ *   - jqProcessor values are copied verbatim from jobqueue_xenon.h:18-26. They
+ *     are bit positions in jqProcessorsMask, not hardware ids.
+ */
+#ifndef JOBQUEUE_WEB_H
+#define JOBQUEUE_WEB_H
+
+#include "system/scheduler/core/tl_defs.h"
+
+namespace Scheduler
+{
+
+enum jqProcessor
+{
+	JQ_CORE_0 = 1 << 0,
+	JQ_CORE_1 = 1 << 1,
+	JQ_CORE_2 = 1 << 2,
+	JQ_CORE_3 = 1 << 3,
+	JQ_CORE_4 = 1 << 4,
+	JQ_CORE_5 = 1 << 5,
+	JQ_CORE_6 = 1 << 6,
+	JQ_CORE_7 = 1 << 7,
+	JQ_CORE_ALL = JQ_CORE_0 | JQ_CORE_1 | JQ_CORE_2 | JQ_CORE_3 |
+	              JQ_CORE_4 | JQ_CORE_5 | JQ_CORE_6 | JQ_CORE_7
+};
+
+//! Pointer to the function that is responsible for actually processing a batch of data.
+typedef void (*jqFunctor)( struct Task* Batch );
+
+struct jqModule
+{
+	jqModule() {}
+	jqModule( jqFunctor Code, const char* Name ) : Code( Code ), Name( Name ) {}
+	jqFunctor Code;
+	const char* Name;
+};
+
+typedef int TaskHandle;
+
+struct _Task
+{
+};
+
+struct _jqWorker
+{
+	int Processor;
+	tlThreadHandle Thread;   /* jobqueue_xenon.h:51 uses HANDLE */
+	int WorkerID;
+	bool Idle;
+};
+
+#define jqPrintf tlPrintf
+
+#define JQ_ASSERT(x, desc) TL_ASSERT(x, desc)
+
+#define JQ_ALIGNED
+#define JQ_DMA_ALIGNED
+
+#define JQ_NO_PPU ERROR_JobQueue_Function_required_on_Xenon
+#define JQ_NO_SPU
+
+#define JQ_DECLARE_MODULE(name,fn,elfname) \
+	Scheduler::jqModule name(fn,#name);
+
+#define JQ_DECLARE_PPU_MODULE(name,fn) \
+	Scheduler::jqModule name(fn,#name);
+
+#define JQ_DECLARE_SPU_MODULE(name,fn,elfname,logger) \
+	Scheduler::jqModule name(fn,#name);
+
+#define JQ_DECLARE_DUAL_MODULE(name,fn,elfname,logger) \
+	Scheduler::jqModule name(fn,#name);
+
+} // namespace Scheduler
+
+/* Fail-loud hook implemented in system/source/scheduler/jobqueue_web.cpp.
+ * Shared code calls it when an input cannot be represented faithfully with a
+ * single execution context; it prints a diagnostic and aborts, so the caller
+ * never continues with a silently dropped policy. */
+namespace Scheduler
+{
+void jqWebFatal( const char* what );
+}
+
+#endif /* JOBQUEUE_WEB_H */
