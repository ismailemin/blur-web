+}
+
+inline tlThreadHandle tlCreateThread( tlThreadFunction entry, INTPTR param,
+	int priority, U32 stacksize, U32 flags, const char* name )
+{
+	return tlCreateThread( entry, param, name, priority, stacksize, flags );
+}
+
+inline void tlExitThread( U32 exitcode )
+{
+	(void)exitcode;
+	tlWebUnsupported( "tlExitThread" );
+}
+
