+/* tl_thread_web.h - TL_PLAT_WEB backend for tl_thread.h.
+ *
+ * SPIKE ARTIFACT, not engine code. Lives in _work/ so that the identity can be
+ * measured without editing upstream/. It is copied into the patched overlay by
+ * make_patched_copy.py.
+ *
+ * Contract (from docs/work/analysis/t005-scheduler-design.md section 3.2-3.3):
+ * one execution context. Nothing here pretends to be parallel and nothing here
+ * returns success for an operation the build cannot perform:
+ *
+ *   tlCreateThread       returns 0 (the invalid handle) and increments a
+ *                        refusal counter. It never runs `entry` inline: every
+ *                        real entry point is a forever-loop.
+ *   tlWaitForThread      aborts through tlWebUnsupported(). Waiting on another
+ *                        context can never complete here.
+ *   tlExitThread         aborts: reaching it means a context that should not
+ *                        exist was entered.
+ *   tlSleep              logged no-op (design 3.6.2): it must never map to
+ *                        Atomics.wait, which throws on the browser main thread.
+ *   tl_threadlocal       thread_local; with one context it is plain storage.
+ *
+ * No numeric priority is invented: the enum below is a total order only. It is
+ * never handed to an OS because no OS thread is ever created.
+ */
+#ifndef TL_THREAD_WEB_H
+#define TL_THREAD_WEB_H
+
+/* Fail-loud hook, defined once in shims/web_runtime.cpp. */
+extern "C" void tlWebUnsupported( const char* what );
+extern "C" unsigned tlWebThreadSpawnRefused;
+extern "C" unsigned tlWebSleepNoopCount;
+
+/* Same width as every other platform's handle (tl_thread.h:46-68). 0 is the
+ * invalid handle, so a caller that ignores the return value cannot mistake it
+ * for a live thread. */
+typedef U64 tlThreadHandle;
+typedef U64 tlThreadId;
+
+/* Same value as tl_thread.h:81 (upstream, inside the platform body). Copied so
+ * the signature and default argument are unchanged. */
+#define TL_THREAD_DEFAULT_STACK_SIZE (32*1024)
+
+/* Cross platform thread priority. A total order only - see the file header. */
+enum tlThreadPriority
+{
+	TL_THREAD_PRIORITY_IDLE          = 0,
+	TL_THREAD_PRIORITY_LOWEST        = 1,
+	TL_THREAD_PRIORITY_BELOW_NORMAL  = 2,
+	TL_THREAD_PRIORITY_NORMAL        = 3,
+	TL_THREAD_PRIORITY_ABOVE_NORMAL  = 4,
+	TL_THREAD_PRIORITY_HIGHEST       = 5,
+	TL_THREAD_PRIORITY_TIME_CRITICAL = 6
+};
+
+/* TL_THREAD_CREATE_SUSPENDED is non-zero so a caller that asks for it is
+ * distinguishable; tlCreateThread refuses every request regardless. */
+enum tlThreadFlags
+{
+	TL_THREAD_JOINABLE         = 0,
+	TL_THREAD_CREATE_SUSPENDED = 1,
+	TL_THREAD_DEFAULT_FLAGS    = TL_THREAD_JOINABLE
+};
+
+typedef void (*tlThreadFunction)( void* );
+
+#define TL_THREAD_FUNCTION(name) void name( void* ThreadParam )
+#define TL_THREAD_RETURN(exitcode) do { (void)(exitcode); return; } while (false)
+
+inline tlThreadHandle tlGetCurrentThread()
+{
+	return (tlThreadHandle)1;   /* the single context's identity */
+}
+
+inline tlThreadId tlGetCurrentThreadId()
+{
+	return (tlThreadId)1;       /* design 3.4: jqGetMainThreadID == 1 */
+}
+
+inline void tlSleep( U32 milliseconds )
+{
+	(void)milliseconds;
+	++tlWebSleepNoopCount;      /* logged no-op, never Atomics.wait */
+}
+
+inline tlThreadHandle tlCreateThread(
