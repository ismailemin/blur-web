--- /dev/null
+++ b/code/mercury/library/common/system/source/scheduler/jobqueue_web.cpp
@@ -0,0 +1,236 @@
+/* jobqueue_web.cpp - Scheduler platform backend for TL_PLAT_WEB.
+ *
+ * The web sibling of jobqueue_xenon.cpp + jobqueue_kernel_xenon.cpp. It
+ * implements exactly the single-execution-context contract written down in
+ * docs/work/analysis/t005-scheduler-design.md sections 3.2-3.4:
+ *
+ *   _Init        jqMaxWorkers = 0, no events, no OS handles
+ *   _Start       zero worker contexts; build the main-thread policy order
+ *   _jqStop      assert the worker count is zero, free the (zero-sized) array
+ *   _AddTask     no-op (also empty on Xenon, jobqueue_xenon.cpp:112-114)
+ *   jqAlertWorker            no-op
+ *   jqWorkerSleep            returns false; never reached, because jqWorkerLoop
+ *                            is only entered with iWorkerID == -1
+ *   jqLockBatchPoolInternal  plain counter; one context cannot interleave
+ *   Flush                    drain inline; bRunJobs is ignored (documented
+ *                            deviation - the two audio call sites)
+ *   jqExecuteBatch / jqCanBatchExecute / jqSafeToPopBatch / GetWorkerID
+ *                            the four hooks the Xenon build takes from
+ *                            jobqueue_kernel_xenon.cpp
+ *
+ * Deliberate differences from jobqueue_xenon.cpp, all recorded:
+ *   - no g_WorkerAlert[8], no SetEvent/WaitForSingleObject/CloseHandle
+ *   - Flush does not poll Time::GetPerformanceCounter: the drain loop cannot
+ *     fail to make progress in one context, so a timeout would be false
+ *   - a JQ_GROUP_LABEL / JQ_GROUP_SPURWLOCK dependency aborts: only the renderer
+ *     can advance a fence and there is no renderer in this module
+ *
+ * NOT a parallel implementation and NOT thread-safe. It must never be described
+ * as one.
+ */
+#include "SystemPch.h"
+
+#include "system/scheduler/jobqueue.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+namespace Scheduler
+{
+
+extern TaskPool jqPool;
+extern int jqNWorkers;
+extern jqWorker* jqWorkers;
+extern int jqMaxWorkers;
+
+bool jqStopSignal = false;
+jqWorker jqMainThreadWorker;
+int jqPoolLock = 0;
+
+void InitWorker( jqWorker* Worker );
+void ShutdownWorker( jqWorker* Worker );
+void jqWorkerLoop( jqWorker* Worker, int GroupID, int iWorkerID );
+
+/* Fail-loud hook. Declared in jobqueue_web.h so shared code (CreatePolicy) can
+ * refuse an input that a single context cannot represent. */
+void jqWebFatal( const char* what )
+{
+	fprintf( stderr, "[scheduler/web] unsupported: %s\n", what ? what : "(null)" );
+	fflush( stderr );
+	abort();
+}
+
+void _Init()
+{
+	jqPoolLock = 0;
+	jqMaxWorkers = 0;   /* one execution context: no worker threads exist */
+}
+
+void _Shutdown()
+{
+	/* no OS handles were created */
+}
+
+void _Start( U32 processorsMask )
+{
+	(void)processorsMask;
+
+	GenerateWorkerPolicyOrder( &jqMainThreadWorker.PolicyOrder, 0 );
+
+	InitWorker( &jqMainThreadWorker );
+	jqMainThreadWorker.Processor = JQ_CORE_0;
+	tlSetCurrentThreadName( "Game Master" );
+}
+
+void _jqStop()
+{
+	/* Design 3.4: assert all counts are zero; nothing else owns a context. */
+	if ( jqPool.QueuedBatchCount != 0 || jqPool.ExecutingBatchCount != 0 )
+		jqWebFatal( "_jqStop with batches still queued/executing" );
+
+	ShutdownWorker( &jqMainThreadWorker );
+
+	/* The invariant is zero worker *contexts*. Start() still calls
+	 * BizAlignedMalloc(sizeof(jqWorker) * 0), which may legally return a
+	 * non-null pointer, so a non-null jqWorkers is not by itself a fault. */
+	if ( jqNWorkers != 0 )
+		jqWebFatal( "_jqStop with a non-zero worker count; no worker can exist here" );
+
+	if ( jqWorkers )
+		BizAlignedFree( jqWorkers );
+	jqWorkers = NULL;
+}
+
+void _AddTask( const Task* Batch, int iPolicy )
+{
+	(void)Batch; (void)iPolicy;   /* same no-op as jobqueue_xenon.cpp:112-114 */
+}
+
+void jqAlertWorker( int iWorkerID )
+{
+	(void)iWorkerID;              /* no worker to wake */
+}
+
+void jqLockBatchPoolInternal()
+{
+	++jqPoolLock;                 /* single context: no CAS needed */
+}
+
+void jqUnlockBatchPoolInternal()
+{
+	--jqPoolLock;
+}
+
+void Flush( GroupHandle GroupID )
+{
+	Flush( GroupID, true );
+}
+
+void Flush( int GroupID, bool bRunJobs, U32 _timeout )
+{
+	(void)bRunJobs;               /* documented deviation: always drain */
+	(void)_timeout;
+
+	if ( GroupID != JQ_GROUP_NONE )
+	{
+		TaskGroup* pGroup = &jqPool.BatchGroupPool[GroupID];
+		for ( int i = 0; i < pGroup->NDependencies; i++ )
+		{
+			int dep = pGroup->Dependencies[i];
+			/* Two dependency forms have no producer in a single context. Both
+			 * are refused with the exact API and the reason, never spun on and
+			 * never skipped: a skipped fence would run work that the renderer
+			 * has not finished reading. */
+			if ( dep == JQ_GROUP_SPURWLOCK )
+				jqWebFatal( "Flush: AddGroupDependency(group, JQ_GROUP_SPURWLOCK, "
+				            "MT::SpuRwLock*) cannot be satisfied - only another "
+				            "context can release the lock" );
+			if ( dep == JQ_GROUP_LABEL )
+				jqWebFatal( "Flush: AddGroupDependency(group, JQ_GROUP_LABEL, U32*) "
+				            "cannot be satisfied - only the renderer can advance "
+				            "the fence value" );
+			Flush( dep );
+		}
+	}
+
+	volatile int* BatchCount;
+	volatile int* ExecutingBatchCount;
+	int previousBatchCount = -1;
+	int stalledIterations = 0;
+	if ( GroupID == JQ_GROUP_NONE )
+	{
+		BatchCount          = &jqPool.QueuedBatchCount;
+		ExecutingBatchCount = &jqPool.ExecutingBatchCount;
+	}
+	else
+	{
+		BatchCount          = &jqPool.BatchGroupPool[GroupID].QueuedBatchCount;
+		ExecutingBatchCount = &jqPool.BatchGroupPool[GroupID].ExecutingBatchCount;
+	}
+
+	for ( ;; )
+	{
+		int bc = *BatchCount;
+		MT::MemoryFence();
+		int ec = *ExecutingBatchCount;
+		if ( ( bc + ec ) == 0 )
+			break;
+
+		if ( !bc )
+			/* ec > 0 with nothing queued: in one context the executor is this
+			 * frame, so this can only mean an unbalanced count. Fail loudly. */
+			jqWebFatal( "Flush sees executing batches with an empty queue" );
+
+		/* A queued batch that no policy can pop would spin here forever (a
+		 * browser hang with no console output). Eight consecutive iterations
+		 * without the queue shrinking is not a slow frame, it is unrunnable
+		 * work - most likely a policy still disabled by column 0. */
+		if ( bc == previousBatchCount )
+		{
+			if ( ++stalledIterations > 8 )
+				jqWebFatal( "Flush cannot make progress: a queued batch is not "
+				            "runnable (a policy disabled by its column 0?)" );
+		}
+		else
+		{
+			previousBatchCount = bc;
+			stalledIterations = 0;
+		}
+
+		jqWorkerLoop( &jqMainThreadWorker, GroupID, -1 );
+	}
+}
+
+/* --- the hooks the Xenon build takes from jobqueue_kernel_xenon.cpp -------- */
+
+void jqExecuteBatch( Task* Batch )
+{
+	Batch->Module->Code( Batch );
+}
+
+bool jqSafeToPopBatch( jqWorker* Worker, jqPriority Priority, bool IsLocal )
+{
+	(void)Worker; (void)Priority; (void)IsLocal;
+	return true;
+}
+
+bool jqCanBatchExecute( Task* Batch, jqWorker* Worker )
+{
+	(void)Batch; (void)Worker;
+	return true;
+}
+
+bool jqWorkerSleep( jqWorker* Worker, int iWorkerID )
+{
+	(void)Worker; (void)iWorkerID;
+	/* jqWorkerLoop is only entered with iWorkerID == -1, so this is dead code;
+	 * returning false means "do not continue", never "slept successfully". */
+	return false;
+}
+
+int GetWorkerID()
+{
+	return 0;                     /* only context */
+}
+
+} // namespace Scheduler
