+template <typename Archive>
+void Deserialise( Archive& ar, LodReader<Texture>& t )
+{
+	PlatformType platformType;
+	ar & platformType;
+
+	if ( platformType != GetPlatformType() )
+		WebSpike::Unsupported( "texture LOD platform tag is not PC", __FILE__, __LINE__ );
+
+	if ( t.m_lod == 0 )
+	{
+		ar & t.m_next.m_name;
+
+		SamplerState samplerState;
+		ar & samplerState;
+		// No FX sampler-state cache exists on this target.
+		t.m_next.m_samplerStateIndex = -1;
+
+		ar & t.m_next.m_hashValue;
+	}
+
+	U32 present = 0;
+	ar >> present;
+
+	const bool paired = ( present > 1 );
+
+	if ( present != 0 )
+	{
+		S32 headerSize = 0;
+		ar & headerSize;
+
+		if ( headerSize < 0 || headerSize > 64 )
+			WebSpike::Unsupported( "texture header size out of range", __FILE__, __LINE__ );
+
+		if ( headerSize > 0 )
+		{
+			U8 headerData[ 64 ];
+			ar.Read( headerData, (U32)headerSize );
+		}
+
+		if ( !paired )
+		{
+			if ( ar.GetVersion() == 0 )
+			{
+				S32 dataSize = 0;
+				ar & dataSize;
+
+				if ( dataSize < 0 )
+					WebSpike::Unsupported( "texture data size is negative", __FILE__, __LINE__ );
+
+				if ( dataSize > 0 )
+				{
+					ar.Read( 0, (U32)dataSize );
+					WebSpike::Draws().texturePayloadBytes += (unsigned long long)dataSize;
+				}
+			}
+			else
+			{
+				ReadObjectMarker( ar, "texture blob object marker/version invalid" );
+				U32 size = 0, alignment = 0, compression = 0;
+				bool endianSwap = false;
+				ar & size;
+				ar & alignment;
+				ar & (U32&)compression;
+				ar & endianSwap;
+
+				if ( alignment == 0 || alignment > 4096 ||
+					( alignment & ( alignment - 1 ) ) != 0 )
+					WebSpike::Unsupported( "texture blob alignment invalid",
+						__FILE__, __LINE__ );
+
+				if ( compression == Arch::NO_COMPRESSION )
+				{
+					ar.Align( alignment );
+					ar.Read( 0, size );
+					WebSpike::Draws().texturePayloadBytes += (unsigned long long)size;
+				}
+				else
+				{
+					S32 count = 0;
+					ar >> count;
+					for ( int i = 0; i < count; i++ )
+					{
+						U32 originalSize = 0, compressedSize = 0;
+						ar & originalSize;
+						ar & compressedSize;
+						ar.Align( alignment );
+						ar.Read( 0, compressedSize );
+					}
+					++WebSpike::Draws().compressedBuffers;
+				}
+			}
+		}
+		else
+		{
+			ar & t.m_source;
+		}
+
+		// The texture itself is not created: m_discard says exactly that, the
+		// same state the PC path stores after a failed CreateTexture2D.
+		t.m_next.m_discard = 1;
+		++WebSpike::Draws().texturesDiscarded;
+	}
+
+	++WebSpike::Draws().textureLods;
+}
