+template <typename Archive>
+void Deserialise( Archive& ar, LodReader<ResourceBlock::Resources>& t )
+{
+	PlatformType platformType;
+	ar & platformType;
+
+	if ( platformType != GetPlatformType() )
+		WebSpike::Unsupported( "resource block platform tag is not PC", __FILE__, __LINE__ );
+
+	ResourceBlock::Resources& next( t.m_next );
+	next.discard = false;
+
+	S32 lod = -1;
+	ar & lod;
+
+	if ( lod != t.m_lod )
+		WebSpike::Unsupported( "resource block LOD differs from its reader", __FILE__, __LINE__ );
+
+	if ( lod == 0 )
+	{
+		ar & next.vertexBuffers;
+		ar & next.indexBuffers;
+		ar & next.nodes;
+
+		for ( int i = 0; i < next.nodes.Size(); i++ )
+		{
+			Node* pNode = &*next.nodes[ i ];
+
+			if ( pNode )
+				pNode->SetScenePtr( next.pScene );
+		}
+
+		WebSpike::Draws().resourceNodes += next.nodes.Size();
+	}
+
+	{
+		S32 nTextures = 0;
+		ar & nTextures;
+
+		if ( nTextures < 0 || nTextures > 16 )
+			WebSpike::Unsupported( "resource texture count out of range", __FILE__, __LINE__ );
+
+		next.textures.Resize( nTextures );
+
+		for ( int i = 0; i < nTextures; i++ )
+		{
+			const Texture* pFront = 0;
+
+			if ( t.m_pBack && !t.m_pBack->Empty() && i < t.m_pBack->textures.Size()
+				&& t.m_pBack->textures[ i ] != 0 )
+				pFront = &*t.m_pBack->textures[ i ];
+
+			if ( t.m_pFront && ( pFront == 0 || !pFront->GetData().IsCreated() )
+				&& i < t.m_pFront->textures.Size()
+				&& t.m_pFront->textures[ i ] != 0 )
+				pFront = &*t.m_pFront->textures[ i ];
+
+			Allocate( next.textures[ i ] );
+
+			LodReader<Texture> textureLod( pFront, 0, *next.textures[ i ], t.m_lod );
+			ar & textureLod;
+
+			// Upstream marks the block discarded when a texture failed to
+			// create. Here no texture is meant to be created, so the flag is
+			// not a load failure; it is reported separately.
+		}
+
+		WebSpike::Draws().resourceTextures += nTextures;
+	}
+
+	next.lod = t.m_lod;
+	++WebSpike::Draws().resourceLods;
+}
