+// Non-streamed resource block loading, data-only (see the PC #else body).
+template <typename Archive>
+void Deserialise( Archive& ar, ResourceBlock& t )
+{
+	g_resourceAllocatorMutex.Wait();
+
+	PlatformType platformType;
+	ar & platformType;
+
+	if ( platformType != GetPlatformType() )
+		WebSpike::Unsupported( "resource block platform tag is not PC", __FILE__, __LINE__ );
+
+	t.m_back.discard = false;
+
+	S32 numLods = 0;
+	ar & numLods;
+
+	if ( numLods < 0 || numLods > 64 )
+		WebSpike::Unsupported( "resource block LOD count out of range", __FILE__, __LINE__ );
+
+	for ( int i = 0; i < numLods; i++ )
+	{
+		ResourceBlock::Resources resources;
+		resources.pScene = t.m_resources.pScene;
+
+		LodReader<ResourceBlock::Resources> blockLod( 0, 0, resources, i );
+		ar & blockLod;
+
+		ResourceBlock::SwapNew( t.m_back, resources );
+	}
+
+	ResourceBlock::SwapNew( t.m_resources, t.m_back );
+
+	g_resourceAllocatorMutex.Release();
+}
