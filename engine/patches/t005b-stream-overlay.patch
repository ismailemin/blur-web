+/* P27 data-only resource import.
+ *
+ * The next five functions are the web siblings of the PC deserialisers that
+ * follow (IndexBuffer, VertexBuffer, LodReader<Texture>,
+ * LodReader<ResourceBlock::Resources>, ResourceBlock). The serialised field
+ * order is copied from them exactly; the only difference is that a GPU object
+ * would be *created* by the PC branch, and here the descriptor is recorded and
+ * the payload bytes are skipped or retained. No device entry point is called.
+ * Reaching a case that genuinely needs a device is a fail-loud Unsupported().
+ */
+template <typename Archive>
+static void ReadObjectMarker( Archive& ar, const char* what )
+{
+	// BinaryInputArchive::operator>> writes a 'AR' tag and a U16 object version
+	// before every non-primitive object, including Arch::Deserialiser. The blob
+	// header therefore starts after them.
+	U16 marker = 0;
+	U16 version = 0;
+	ar & marker;
+	ar & version;
+
+	if ( marker != (U16)'AR' || version != 0 )
+		WebSpike::Unsupported( what, __FILE__, __LINE__ );
+}
+
+template <typename Archive>
+static void ReadBlobHeader( Archive& ar, U32 expectedBytes, WebSpike::BufferRecord* pRecord )
+{
+	ReadObjectMarker( ar, "buffer blob object marker/version invalid" );
+
+	U32 size = 0;
+	U32 alignment = 0;
+	U32 compression = 0;
+	bool endianSwap = false;
+
+	pRecord->streamOffset = (unsigned long long)ar.Stream().GetPosition();
+
+	ar & size;
+	ar & alignment;
+	ar & (U32&)compression;
+	ar & endianSwap;
+
+	pRecord->alignment = (int)alignment;
+	pRecord->compression = (int)compression;
+	pRecord->endianSwap = endianSwap ? 1 : 0;
+
+	if ( size != expectedBytes )
+	{
+		fprintf( stderr, "[t005e] buffer blob mismatch: record=%d count=%d stride=%d "
+			"expected=%u declared=%u offset=%llu compression=%u\n",
+			pRecord->kind, pRecord->count, pRecord->stride, expectedBytes, size,
+			pRecord->streamOffset, compression );
+		fflush( stderr );
+		WebSpike::Unsupported( "buffer blob size differs from its descriptor",
+			__FILE__, __LINE__ );
+	}
+
+	if ( alignment == 0 || alignment > 4096 || ( alignment & ( alignment - 1 ) ) != 0 )
+		WebSpike::Unsupported( "buffer blob alignment is not a power of two <= 4096",
+			__FILE__, __LINE__ );
+
+	if ( compression == Arch::NO_COMPRESSION )
+	{
+		ar.Align( alignment );
+
+		if ( expectedBytes == 0 )
+			return;
+
+		int arenaOffset = -1;
+		U8* pDest = WebSpike::RetainBytes( (int)expectedBytes, &arenaOffset );
+
+		if ( pDest == 0 )
+		{
+			// The descriptor is still valid; the payload is simply not kept.
+			// The record says so, so a caller cannot mistake absent bytes for
+			// zero-filled geometry.
+			++WebSpike::Draws().arenaExhausted;
+			ar.Read( 0, expectedBytes );
+			return;
+		}
+
+		const U64 before = ar.Stream().GetPosition();
+		ar.Read( pDest, expectedBytes );
+		const U64 consumed = ar.Stream().GetPosition() - before;
+
+		if ( consumed != (U64)expectedBytes )
+			WebSpike::ArchiveUnderflow( __FILE__, __LINE__, (U64)expectedBytes, consumed );
+
+		pRecord->payloadRetained = 1;
+		pRecord->payloadOffset = arenaOffset;
+		return;
+	}
+
+	// Compressed blob: consume the fragments exactly as Arch::Serialiser writes
+	// them. There is no decompressor on this target, so the bytes are dropped
+	// and the record keeps compression != 0; the draw list never treats such a
+	// buffer as if it had data.
+	++WebSpike::Draws().compressedBuffers;
+
+	S32 count = 0;
+	ar >> count;
+
+	for ( int i = 0; i < count; i++ )
+	{
+		U32 originalSize = 0;
+		U32 compressedSize = 0;
+
+		ar & originalSize;
+		ar & compressedSize;
+		ar.Align( alignment );
+		ar.Read( 0, compressedSize );
+	}
+}
+
+static WebSpike::BufferRecord* BeginBuffer( int kind, int count, int stride, int bytes )
+{
+	return WebSpike::AddBuffer( kind, count, stride, bytes );
+}
+
+template <typename Archive>
+void Deserialise( Archive& ar, IndexBuffer& t )
+{
+	S32 size;
+	IndexType indexType;
+	ar & size;
+	ar & indexType;
+
+	U32 bufferSize = 0;
+
+	if ( indexType == INDEX_TYPE_U16 )
+		bufferSize = (U32)size * 2;
+	else if ( indexType == INDEX_TYPE_U32 )
+		bufferSize = (U32)size * 4;
+	else
+		WebSpike::Unsupported( "Index type corrupt", __FILE__, __LINE__ );
+
+	WebSpike::BufferRecord* pRecord =
+		BeginBuffer( 1, (int)size, ( indexType == INDEX_TYPE_U16 ) ? 2 : 4,
+			(int)bufferSize );
+
+	if ( pRecord == 0 )
+	{
+		// Bound exceeded: consume the payload so the stream stays in step, but
+		// keep the counter that makes the gate fail.
+		if ( ar.GetVersion() > 0 )
+		{
+			ReadObjectMarker( ar, "index buffer blob object marker/version invalid" );
+			U32 blobSize = 0, alignment = 0, compression = 0;
+			bool endianSwap = false;
+			ar & blobSize;
+			ar & alignment;
+			ar & (U32&)compression;
+			ar & endianSwap;
+			ar.Align( alignment );
+			ar.Read( 0, blobSize );
+		}
+		else
+		{
+			ar.Read( 0, bufferSize );
+		}
+		return;
+	}
+
+	if ( ar.GetVersion() > 0 )
+	{
+		ReadBlobHeader( ar, bufferSize, pRecord );
+	}
+	else
+	{
+		pRecord->streamOffset = ar.Stream().GetPosition();
+		ar.Read( 0, bufferSize );
+	}
+}
+
+template <typename Archive>
+void Deserialise( Archive& ar, VertexBuffer& t )
+{
+	S32 size;
+	VertexFormat vertexFormat;
+	ar & vertexFormat;
+	ar & size;
+
+	const U32 bufferSize = (U32)size * vertexFormat.GetDataSize();
+
+	WebSpike::BufferRecord* pRecord =
+		BeginBuffer( 0, (int)size, (int)vertexFormat.GetDataSize(), (int)bufferSize );
+
+	if ( pRecord == 0 )
+	{
+		if ( ar.GetVersion() > 0 )
+		{
+			ReadObjectMarker( ar, "vertex buffer blob object marker/version invalid" );
+			U32 blobSize = 0, alignment = 0, compression = 0;
+			bool endianSwap = false;
+			ar & blobSize;
+			ar & alignment;
+			ar & (U32&)compression;
+			ar & endianSwap;
+			ar.Align( alignment );
+			ar.Read( 0, blobSize );
+		}
+		else
+		{
+			ar.Read( 0, bufferSize );
+		}
+		return;
+	}
+
+	if ( ar.GetVersion() > 0 )
+	{
+		ReadBlobHeader( ar, bufferSize, pRecord );
+	}
+	else
+	{
+		pRecord->streamOffset = ar.Stream().GetPosition();
+		ar.Read( 0, bufferSize );
+	}
+}
